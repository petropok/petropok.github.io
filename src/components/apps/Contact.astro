<section class="app-content contact-app">
  <div class="banner glass-card">
    <span class="mail-icon" aria-hidden="true">📨</span>

    <div>
      <span class="eyebrow">CONTACT FORMS</span>
      <h1>Send an email my way.</h1>
      <p>
        For project inquiries, job opportunities, or a friendly hello, send a note.
      </p>
    </div>
  </div>

  <div class="contact-grid">
    <div class="contact-panel glass-card">
      <div class="contact-row">
        <span>Email</span>

        <div class="contact-email">
          <a href="mailto:mimogios@gmail.com">
            mimogios@gmail.com
          </a>

          <button
            type="button"
            class="copy-button"
            data-copy-email="mimogios@gmail.com"
            aria-label="Copy email address"
          >
            ⧉
          </button>
        </div>
      </div>

      <div class="contact-row">
        <span>GitHub</span>
        <a
          href="https://github.com/petropok"
          target="_blank"
          rel="noopener noreferrer"
        >
          github.com/petropok ↗
        </a>
      </div>

      <div class="contact-row">
        <span>LinkedIn</span>
        <a
          href="https://www.linkedin.com/in/petropok/"
          target="_blank"
          rel="noopener noreferrer"
        >
          linkedin.com/in/petropok ↗
        </a>
      </div>

      <div class="contact-status">
        <span class="tray-dot"></span>
        <span>Currently looking for internship</span>
      </div>
    </div>

    <form
      class="contact-form"
      action="https://api.web3forms.com/submit"
      method="POST"
      data-contact-form
    >
      <!-- Honeypot for simple spam filtering -->
      <input
        type="text"
        name="_gotcha"
        tabindex="-1"
        autocomplete="off"
        class="visually-hidden"
      />

      <input 
        type="hidden"
        name="access_key"
        value="b3dad50a-06ac-4b3a-9c16-a1fe53114c2c"
      />

      <label>
        <span>Your name</span>
        <input
          name="name"
          type="text"
          placeholder="Jane Doe"
          autocomplete="name"
          required
        />
      </label>

      <label>
        <span>Your email</span>
        <input
          name="email"
          type="email"
          placeholder="jane@example.com"
          autocomplete="email"
          required
        />
      </label>

      <label>
        <span>Message</span>
        <textarea
          name="message"
          rows="5"
          placeholder="Tell me what's up…"
          required
        ></textarea>
      </label>

      <button
        class="aero-button"
        type="submit"
        data-submit-button
      >
        <span aria-hidden="true">✉️</span>
        <span data-submit-label>Send message</span>
      </button>

      <p
        class="form-status"
        data-form-status
        role="status"
        aria-live="polite"
      ></p>

      <p class="form-note">
        Your message will open a secure delivery connection.
      </p>
    </form>
  </div>
</section>

<script>
  const contactForm =
    document.querySelector<HTMLFormElement>(
      '[data-contact-form]',
    );

  const submitButton =
    document.querySelector<HTMLButtonElement>(
      '[data-submit-button]',
    );

  const submitLabel =
    document.querySelector<HTMLElement>(
      '[data-submit-label]',
    );

  const formStatus =
    document.querySelector<HTMLElement>(
      '[data-form-status]',
    );

  const copyButtons =
    document.querySelectorAll<HTMLButtonElement>(
      '[data-copy-email]',
    );

  function setStatus(
    message: string,
    type: 'success' | 'error' | 'default' = 'default',
  ) {
    if (!formStatus) return;

    formStatus.textContent = message;
    formStatus.dataset.status = type;
  }

  contactForm?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!submitButton || !submitLabel || !formStatus) {
      return;
    }

    const formData = new FormData(contactForm);

    const honeypot = formData.get('_gotcha');

    if ( typeof honeypot === 'string' && honeypot.trim() !== '') {
      // Bot detected.
      return;
    }
    
    submitButton.disabled = true;
    submitLabel.textContent = 'Sending…';
    setStatus('Connecting to mail server…');

    try {
      const response = await fetch(
        'https://api.web3forms.com/submit',
        {
          method: 'POST',
          body: formData,
          headers: {
            Accept: 'application/json',
          },
        },
      );

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(
          result.message || 'Submission failed',
        );
      }

      contactForm.reset();

      submitLabel.textContent = 'Message sent!';

      setStatus(
        'Thanks! Your message has been sent successfully.',
        'success',
      );
    } catch (error) {
      submitLabel.textContent = 'Send message';

      setStatus(
        'Something went wrong. Please email me directly instead.',
        'error',
      );
    } finally {
      submitButton.disabled = false;
    }
  });

  copyButtons.forEach((button) => {
    button.addEventListener(
      'click',
      async () => {
        const email =
          button.dataset.copyEmail;

        if (!email) return;

        try {
          await navigator.clipboard.writeText(
            email,
          );

          const original =
            button.textContent;

          button.textContent = '✓';

          window.setTimeout(() => {
            button.textContent =
              original;
          }, 1500);
        } catch {
          setStatus(
            'Unable to copy email address.',
            'error',
          );
        }
      },
    );
  });
</script>