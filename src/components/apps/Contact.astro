<section class="app-content contact-app">
  <div class="mail-banner glass-card">
    <span class="mail-icon" aria-hidden="true">✉</span>
    <div>
      <span class="eyebrow">CONTACT FORMS</span>
      <h1>Send an email my way.</h1>
      <p>For project inquiries, job opportunities, or a friendly hello, send a note.</p>
    </div>
  </div>

  <div class="contact-grid">
    <div class="contact-panel glass-card">
      <div class="contact-row"><span>Email</span><a href="mailto:mimogios@gmail.com">mimogios@gmail.com</a></div>
      <div class="contact-row"><span>GitHub</span><a href="https://github.com/petropok" aria-label="GitHub profile">github.com/petropok</a></div>
      <div class="contact-row"><span>LinkedIn</span><a href="https://www.linkedin.com/in/petropok/" aria-label="LinkedIn profile">linkedin.com/in/petropok</a></div>
    </div>
    <form class="contact-form" data-contact-form>
      <label>
        <span>Your email</span>
        <input name="email" type="text" placeholder="Your email here" required />
      </label>
      <label>
        <span>Your name</span>
        <input name="name" type="text" placeholder="Your name here" required />
      </label>
      <label>
        <span>Message</span>
        <textarea name="message" rows="4" placeholder="Your message here..." required></textarea>
      </label>
      <button class="aero-button" type="submit"><span aria-hidden="true">✉</span> Send message</button>
      <p class="form-note">This form is still under construction but you can click my email on the side.</p>
    </form>
  </div>
</section>
