---
import { apps } from '../lib/apps';
import Window from './Window.astro';
import DesktopIcon from './DesktopIcon.astro';
import Taskbar from './Taskbar.astro';
import About from './apps/About.astro';
import Experience from './apps/Experience.astro';
import Projects from './apps/Projects.astro';
import Contact from './apps/Contact.astro';
import Personalization from './apps/Personalization.astro';
import hamster from '../assets/hamster.webp'

const appComponents = { about: About, experience: Experience, projects: Projects, contact: Contact, personalization: Personalization };
---
<div class="desktop-shell" data-desktop-shell>

  <header class="desktop-brand" data-snap-target>
    <img class="brand-mark" src={hamster.src}/>
    <div>
      <strong>PetroDesk</strong>
      <span>kip_portfolio.exe</span>
      <div>
        <a class="shell-svg" href="https://github.com/petropok">
          <svg xmlns="http://www.w3.org/2000/svg" width="1.5em" height="1.5em" viewBox="-2 -2 24 24">
            <title>github</title>
            <path fill="currentColor" d="M18.88 1.099Q17.78-.001 16.233 0H3.746Q2.198 0 1.099 1.099Q-.001 2.199 0 3.746v12.487q0 1.548 1.099 2.647q1.1 1.1 2.647 1.099H6.66q.285 0 .429-.02a.5.5 0 0 0 .286-.169q.143-.15.143-.435l-.007-.885q-.006-.846-.006-1.34l-.3.052q-.285.052-.721.046a5.6 5.6 0 0 1-.904-.091a2 2 0 0 1-.872-.39a1.65 1.65 0 0 1-.572-.8l-.13-.3a3.3 3.3 0 0 0-.41-.663q-.28-.364-.566-.494l-.09-.065a1 1 0 0 1-.17-.156a.7.7 0 0 1-.117-.182q-.039-.092.065-.15q.104-.06.378-.059l.26.04q.26.051.643.311a2.1 2.1 0 0 1 .631.677q.3.532.722.813q.423.28.852.28t.742-.065a2.6 2.6 0 0 0 .585-.196q.117-.871.637-1.34a9 9 0 0 1-1.333-.234a5.3 5.3 0 0 1-1.223-.507a3.5 3.5 0 0 1-1.047-.872q-.416-.52-.683-1.365q-.266-.846-.266-1.952q0-1.573 1.027-2.68q-.48-1.183.091-2.652q.378-.118 1.119.175t1.086.5q.345.21.553.352a9.2 9.2 0 0 1 2.497-.338q1.288 0 2.498.338l.494-.312a7 7 0 0 1 1.197-.572q.689-.26 1.054-.143q.585 1.47.103 2.653q1.028 1.105 1.028 2.68q0 1.106-.267 1.957q-.266.852-.689 1.366a3.7 3.7 0 0 1-1.053.865q-.63.351-1.223.507a9 9 0 0 1-1.333.235q.675.585.676 1.846v3.11q0 .22.065.357a.36.36 0 0 0 .208.189q.143.052.254.064q.111.014.318.013h2.914q1.548 0 2.647-1.099t1.099-2.647V3.746q0-1.548-1.1-2.647z"/>
          </svg>
        </a>
        <a class="shell-svg" href="https://www.linkedin.com/in/petropok/">
          <svg xmlns="http://www.w3.org/2000/svg" width="1.5em" height="1.5em" viewBox="0 0 16 16">
            <title>linkedin</title>
            <path fill="currentColor" fill-rule="evenodd" d="M3 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2zm1.102 4.297a1.195 1.195 0 1 0 0-2.39a1.195 1.195 0 0 0 0 2.39m1 7.516V6.234h-2v6.579zM6.43 6.234h2v.881c.295-.462.943-1.084 2.148-1.084c1.438 0 2.219.953 2.219 2.766c0 .087.008.484.008.484v3.531h-2v-3.53c0-.485-.102-1.438-1.18-1.438c-1.079 0-1.17 1.198-1.195 1.982v2.986h-2z" clip-rule="evenodd"/>
          </svg>
        </a>
        <a class="shell-svg" href="https://github.com/petropok/petropok.github.io">
          <svg xmlns="http://www.w3.org/2000/svg" width="1.5em" height="1.5em" viewBox="0 0 48 48">
            <title>Website Code</title>
            <path fill="currentColor" fill-rule="evenodd" d="M8.095 1.546C11.381 1.279 16.586 1 24 1s12.619.279 15.905.546c3.532.287 6.263 3.017 6.55 6.55C46.722 11.38 47 16.585 47 24s-.278 12.619-.545 15.905c-.287 3.532-3.018 6.263-6.55 6.55C36.619 46.722 31.414 47 24 47s-12.619-.278-15.905-.545c-3.532-.287-6.263-3.018-6.55-6.55C1.28 36.619 1 31.414 1 24s.279-12.619.546-15.905c.287-3.532 3.017-6.263 6.55-6.55M5.175 14.5A239 239 0 0 0 5 24c0 7.314.275 12.41.532 15.58c.129 1.58 1.309 2.76 2.887 2.888C11.59 42.725 16.686 43 24 43s12.41-.275 15.58-.532c1.58-.129 2.76-1.309 2.888-2.887C42.725 36.41 43 31.314 43 24c0-3.73-.071-6.884-.176-9.5zm2.075-6c0-.966.784-1.75 1.75-1.75h2a1.75 1.75 0 1 1 0 3.5H9A1.75 1.75 0 0 1 7.25 8.5M17 6.75a1.75 1.75 0 1 0 0 3.5h2a1.75 1.75 0 1 0 0-3.5z" clip-rule="evenodd"/>
          </svg>
        </a>
      </div>
    </div>
  </header>

  <div class="desktop-icons" aria-label="Desktop applications">
    {apps.map((app) => <DesktopIcon {...app} />)}
  </div>

  <main class="window-layer" aria-live="polite">
    <div class="snap-preview" data-snap-preview aria-hidden="true"></div>
    {apps.map((app, index) => {
      const AppContent = appComponents[app.id];
      return <Window {...app} zIndex={index + 10}><AppContent /></Window>;
    })}
  </main>

  <div class="toast" data-toast-region role="status" aria-live="polite"></div>
  <Taskbar />
</div>

<script>
  import { themeManager } from '../lib/ThemeManager';

  themeManager.init();
  import { WindowManager } from '../lib/WindowManager';

  const shell = document.querySelector<HTMLElement>('[data-desktop-shell]');
  const startButton = document.querySelector<HTMLButtonElement>('[data-start-button]');
  const startMenu = document.querySelector<HTMLElement>('[data-start-menu]');
  const toastRegion = document.querySelector<HTMLElement>('[data-toast-region]');
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (shell) {
    const manager = new WindowManager(shell);

    const openApp = (id: string) => {
      manager.open(id);
      startMenu?.setAttribute('hidden', '');
      startButton?.setAttribute('aria-expanded', 'false');
    };

    document.querySelectorAll<HTMLButtonElement>('[data-open-app]').forEach((button) => {
      button.addEventListener('click', () => openApp(button.dataset.openApp ?? ''));
    });

    if (startButton && startMenu) {
      startButton.addEventListener('click', () => {
        const open =
          startButton.getAttribute('aria-expanded') === 'true';

        startButton.setAttribute(
          'aria-expanded',
          String(!open),
        );

        if (open) {
          startMenu.setAttribute('hidden', '');
        } else {
          startMenu.removeAttribute('hidden');
        }
      });
    }

    document.addEventListener('click', (event) => {
      if (!startMenu || !startButton) return;
      if (startMenu.hasAttribute('hidden')) return;

      const target = event.target as Node;

      if (
        !startMenu.contains(target) &&
        !startButton.contains(target)
      ) {
        startMenu.setAttribute('hidden', '');
        startButton.setAttribute('aria-expanded', 'false');
      }
    });

    const showToast = (message: string) => {
      if (!toastRegion) return;
      toastRegion.textContent = message;
      toastRegion.classList.add('show');
      window.setTimeout(() => toastRegion.classList.remove('show'), 2200);
    };

    document.querySelectorAll<HTMLElement>('[data-toast]').forEach((el) => {
      el.addEventListener('click', () => showToast(el.dataset.toast ?? 'Done'));
    });

    document.querySelectorAll<HTMLElement>('[data-window-tab]').forEach((tab) => {
      tab.addEventListener('click', (event) => {
        const target = event.currentTarget as HTMLElement;
        const windowEl = target.closest<HTMLElement>('[data-window-id]');
        if (!windowEl) return;
        windowEl.querySelectorAll<HTMLElement>('[data-window-tab]').forEach((item) => item.classList.remove('is-active'));
        target.classList.add('is-active');
      });
    });

    document.querySelectorAll<HTMLElement>('[data-window-tab-close]').forEach((tabClose) => {
      tabClose.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        tabClose.click();
      });
    });

    contactForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      showToast('Message queued — connect your form endpoint in Contact.astro');
      contactForm.reset();
    });

    const updateClock = () => {
      const now = new Date();
      if (clock) clock.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    };
    updateClock();
    window.setInterval(updateClock, 30_000);
  }
</script>
