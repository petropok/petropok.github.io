---
import '../styles/global.css';

const { title = 'Kip Portfolio website' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="Konstantinos's Desktop-style website portfolio" />
    <link rel="icon" href="/kip-favicon.svg" sizes="any">
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
